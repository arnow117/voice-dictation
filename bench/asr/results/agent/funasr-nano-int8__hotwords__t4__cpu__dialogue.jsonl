{"type": "clip", "id": "entity-001", "category": "entity", "duration": 9.796, "target_s": null, "hyp": "朴贤真这部解禁男女也太敢拍了，徐贤和李俊荣在办公室互系领带那段看得我脚趾抠地。", "decode_s": 2.1392, "rebuild_s": 4.038, "hotword_count": 7, "error": null}
